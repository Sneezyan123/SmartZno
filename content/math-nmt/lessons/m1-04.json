      "type": "list",
      "content": "Для a ≠ 0:",
      "items": [
        "a^m · a^n = a^(m+n)",
        "a^m / a^n = a^(m−n)",
        "(a^m)^n = a^(mn)",
        "a^0 = 1",
        "a^(−n) = 1/a^n"
      ]
    },
    {
      "type": "formula",
      "content": "Стандартний вигляд: a · 10^k, де 1 ≤ |a| < 10"
    },
    {
