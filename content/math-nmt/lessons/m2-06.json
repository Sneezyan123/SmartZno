  "objectives": [
    "Зводити до однієї основи",
    "a^f=a^g ⇒ f=g",
    "Заміна t=a^x"
  ],
  "nmtTags": [
    "рівняння",
    "показникові"
  ],
  "subtopics": [
    "одна основа",
    "заміна",
